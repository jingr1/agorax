{
  "name": "agorax",
  "version": "2.5.0",
  "description": "Agorax — The agora for AI agents: chat, orchestration, and multi-agent collaboration",
  "author": "jingr1 (https://github.com/jingr1)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "bash scripts/start-stack.sh dev",
    "dev:ui": "PORT=${PORT:-6734} vite dev",
    "dev:clean": "rm -rf node_modules/.vite && PORT=${PORT:-6734} vite dev",
    "build": "vite build",
    "dev:managed-agent": "bash scripts/start-managed-agent-host.sh",
    "start": "bash scripts/start-stack.sh prod",
    "start:ui": "node server-entry.js",
    "start:dev": "pnpm run dev:ui",
    "release:build": "pnpm --dir ../agorax-release build",
    "release:start": "PORT=${PORT:-6734} pnpm --dir ../agorax-release start",
    "release:sync": "git -C ../agorax-release checkout --detach $(git rev-parse HEAD)",
    "preview": "vite preview",
    "test": "vitest run",
    "smoke:managed": "node scripts/managed-companion-smoke.mjs",
    "lint": "eslint",
    "format": "prettier",
    "check": "prettier --write . && eslint --fix",
    "electron:dev": "electron .",
    "electron:build": "pnpm build && pnpm electron:bundle-server && electron-builder --config electron-builder.config.cjs",
    "electron:build:mac": "pnpm build && pnpm electron:bundle-server && electron-builder --mac --config electron-builder.config.cjs",
    "electron:build:win": "pnpm build && pnpm electron:bundle-server && electron-builder --win --config electron-builder.config.cjs",
    "electron:bundle-server": "esbuild dist/server/server.js --bundle --platform=node --format=cjs --outfile=electron/server-bundle.cjs"
  },
  "dependencies": {
    "@agorax/agent-activity-core": "workspace:*",
    "@agorax/agent-activity-daemon-adapter": "workspace:*",
    "@base-ui/react": "^1.1.0",
    "@excalidraw/excalidraw": "^0.18.0",
    "@fontsource-variable/lexend": "^5.2.11",
    "@hugeicons/core-free-icons": "^3.1.1",
    "@hugeicons/react": "^1.1.4",
    "@lobehub/icons": "^5.0.1",
    "@lobehub/icons-static-png": "^1.83.0",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.166.7",
    "@tanstack/react-router-devtools": "1.166.7",
    "@tanstack/react-router-ssr-query": "1.166.7",
    "@tanstack/react-start": "1.166.8",
    "@tanstack/router-plugin": "1.166.7",
    "@types/react-grid-layout": "^1.3.6",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.36.0",
    "katex": "^0.16.22",
    "marked": "^17.0.1",
    "mermaid": "^11.16.1",
    "motion": "^12.29.2",
    "motion-dom": "^12.36.0",
    "motion-utils": "^12.36.0",
    "playwright": "^1.58.2",
    "playwright-extra": "^4.3.6",
    "prismjs": "^1.30.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-joyride": "^2.9.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.21.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "vite-tsconfig-paths": "^6.0.2",
    "ws": "^8.21.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "0.3.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^8.2.2",
    "electron": "^40.8.2",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.0",
    "eslint": "^10.2.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.5",
    "vitest": "^3.2.6",
    "web-vitals": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "electron-winstaller",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
