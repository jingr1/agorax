# Agent registry template (git-tracked).
# Install / first load copies this file to agents.yaml (gitignored).
# New Agent and registry APIs write agents.yaml only — no overlay merge.
# ensureProfile: true → install.sh + agent-chat fallback create ~/.hermes/profiles/<id>
#   (clone-from default) then sync-swarm-profiles.
# default uses ~/.hermes (not profiles/default). Managed runtimes need no Hermes profile.

version: 1
agents:
# Implicit Hermes root (~/.hermes), not profiles/default. Persona seeded from
# NousResearch/hermes-agent DEFAULT_SOUL_MD (SOUL.md); see upstream README.
- id: default
  name: Default
  displayName: Hermes Agent
  role: Primary Hermes Agent (Nous Research)
  specialty: >
    General-purpose self-improving agent — coding, research, tools/skills/MCP,
    memory and session recall, cron automations, and messaging-gateway chat.
    Identity lives in ~/.hermes/SOUL.md (direct, proportional answers; no filler).
  mission: >
    Be the workspace default Hermes home agent rooted at ~/.hermes (config,
    skills, sessions, gateway). Help with questions, code, analysis, and
    tool-backed actions; learn durable skills and memory across sessions.
    Not a Swarm pipeline worker (dispatchable: false) — named profiles
    (orchestrator…learning) handle specialized swarm lanes.
  profile: default
  modes: []
  tools: []
  skills: []
  plugins: []
  pluginToolsets: []
  mcpServers: []
  capabilities:
    - general-purpose
    - coding
    - research
    - tools
    - skills
    - memory
    - session-search
    - cron
    - messaging-gateway
  preferredTaskTypes:
    - chat
    - coding
    - research
    - automation
  greenlightRequiredFor: []
  maxConcurrentTasks: 1
  acceptsBroadcast: true
  reviewRequired: false
  runtime: hermes
  execution: local
  dispatchable: false
  enabled: true
- id: orchestrator
  name: Orchestrator
  role: Swarm Orchestrator / Greenlight Gate
  specialty: mission routing, task decomposition, handoffs, proof contracts, human
    approval gates
  mission: Decompose missions into safe, proof-bearing work and route to the right
    specialist while preserving human greenlight control.
  profile: orchestrator
  ensureProfile: true
  modes:
  - plan
  - autoresearch
  - autoresearch-dispatch
  tools:
  - todo
  - kanban
  - delegation
  - terminal
  - file
  - session_search
  - cronjob
  - skills
  - clarify
  - web
  skills:
  - orchestrator-core
  - mission-memory-layout
  - gstack-for-hermes
  - llm-wiki
  - kanban-orchestrator
  - writing-plans
  - autoresearch
  - autoresearch-plan
  - autoresearch-orchestrate
  plugins: []
  pluginToolsets: []
  mcpServers: []
  wrapper: orchestrator:plan
  capabilities:
  - orchestration
  - decomposition
  - routing
  - proof-contracts
  - greenlight-gate
  - autoresearch-dispatch
  preferredTaskTypes:
  - orchestration
  - planning
  - routing
  - coordination
  - handoff
  - autoresearch-dispatch
  greenlightRequiredFor:
  - merge
  - publish
  - destructive
  - external-send
  - credential-change
  - long-running-loop
  maxConcurrentTasks: 1
  acceptsBroadcast: true
  reviewRequired: false
  runtime: hermes
  execution: local
  dispatchable: true
  enabled: true
- id: researcher
  name: Researcher
  role: Fact-Finding Research
  specialty: establish facts, competitive analysis, data validation, source tracing,
    wiki-first lookup
  mission: Produce evidence-backed factual research with external verification, explicit
    uncertainty, and full source trails.
  profile: researcher
  ensureProfile: true
  modes:
  - quick
  tools:
  - web
  - browser
  - terminal
  - file
  - vision
  - session_search
  - skills
  - todo
  skills:
  - researcher-core
  - mission-memory-layout
  - llm-wiki
  - browser-harness
  - gstack-for-hermes
  - researcher-quick
  - arxiv
  - youtube-content
  - polymarket
  plugins: []
  pluginToolsets: []
  mcpServers: []
  wrapper: researcher:quick
  capabilities:
  - research
  - fact-establishment
  - source-verification
  - source-tracing
  - wiki-query
  preferredTaskTypes:
  - research
  - competitive-analysis
  - data-validation
  - source-review
  - source-tracing
  greenlightRequiredFor:
  - publish
  - external-send
  - long-running-loop
  maxConcurrentTasks: 1
  acceptsBroadcast: true
  reviewRequired: false
  runtime: hermes
  execution: local
  dispatchable: true
  enabled: true
